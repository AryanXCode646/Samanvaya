# ============================================================
# Samanvaya — .gitignore (Clean & Comprehensive)
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/

# --- Distribution & Packaging ---
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Testing & Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
nosetests.xml
test-results/

# --- Editors & IDEs ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- OS Junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- Temporary Files ---
*.tmp
*.log
*.bak
*.orig
tests/temp_*
tests/*.png
tests/*.json

# --- ML Model Weights & Checkpoints ---
*.ckpt
*.pth
*.pt

# --- Node ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Environment Variables ---
.env
.env.*
!.env.example

# --- Secrets ---
*.pem
*.key
*.p12
*.pfx

# --- Docker ---
.dockerignore

# --- Data & Audit Logs (never commit) ---
data/audit/
data/pipeline/
data/workspace/
data/real/
data/raw/
data/cache/
data/processed/
lunar_core/assets/real_data/*.tif
lunar_core/assets/real_data/*.tiff
lunar_core/assets/real_data/*.img
lunar_core/assets/real_data/*.xml
evaluation_report.*
scenario_*_report.*
*.pdf
evaluation_report.*
scenario_*_report.*
*.pdf
*.zip
baseline_test_results.txt

# --- C++ Build Artifacts ---
csrc/build/
*.o
*.a
*.dll
*.dylib
output*/
